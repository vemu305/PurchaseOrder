{
  "name": "purchase-order",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4.15.0",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "Manager": {
            "password": "Manager",
            "roles": [
              "Manager"
            ]
          },
          "Employee": {
            "password": "Employee",
            "roles": [
              "Employee"
            ]
          },
          "SeniorManager": {
            "password": "SeniorManager",
            "roles": [
              "SeniorManager"
            ]
          },
          "Director": {
            "password": "Director",
            "roles": [
              "Director"
            ]
          }
        }
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        }
      },
      "html5-repo": true,
      "destinations": true,
      "workzone": true
    }
  }
}